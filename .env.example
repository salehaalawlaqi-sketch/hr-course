NVIDIA_API_KEY=

# Postgres connection string (e.g. from a Neon/Vercel Postgres database).
DATABASE_URL=

# Random long string used to sign login session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# Secret code learners can enter at sign-up to get the HR role instead of "learner".
# Share this only with actual HR staff.
HR_SIGNUP_CODE=
